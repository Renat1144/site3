{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "night", "name": "Midnight Blue", "color": "#151822" },
        { "slug": "sea", "name": "Dusty Plum", "color": "#5A4658" },
        { "slug": "coral", "name": "Burnt Sienna", "color": "#B85C45" },
        { "slug": "sun", "name": "Champagne Gold", "color": "#D6BD91" },
        { "slug": "stone", "name": "Warm Taupe", "color": "#E8DFD3" },
        { "slug": "paper", "name": "Soft Ivory", "color": "#F5F1EA" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "size": "0.75rem", "name": "XS" },
        { "slug": "30", "size": "1.25rem", "name": "S" },
        { "slug": "40", "size": "2rem", "name": "M" },
        { "slug": "50", "size": "3.5rem", "name": "L" },
        { "slug": "60", "size": "6rem", "name": "XL" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Manrope, sans-serif",
          "name": "Manrope",
          "slug": "manrope",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "src": ["file:./assets/fonts/Manrope-VariableFont_wght.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Platypi, serif",
          "name": "Platypi",
          "slug": "platypi",
          "fontFace": [
            {
              "fontFamily": "Platypi",
              "fontStyle": "normal",
              "fontWeight": "300 800",
              "src": ["file:./assets/fonts/Platypi-VariableFont_wght.woff2"]
            }
          ]
        },
        {
          "fontFamily": "Unbounded, sans-serif",
          "name": "Unbounded",
          "slug": "unbounded",
          "fontFace": [
            {
              "fontFamily": "Unbounded",
              "fontStyle": "normal",
              "fontWeight": "300 600",
              "src": ["file:./assets/fonts/Unbounded-VariableFont_wght.ttf"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.72rem", "name": "Caption" },
        { "slug": "sm", "size": "0.9rem", "name": "Small" },
        { "slug": "md", "size": "1.05rem", "name": "Body" },
        { "slug": "lg", "size": "clamp(1.25rem, 2vw, 1.7rem)", "name": "Lead" },
        { "slug": "xl", "size": "clamp(2.8rem, 6vw, 6.4rem)", "name": "Section" },
        { "slug": "hero", "size": "clamp(4.2rem, 10.5vw, 10.5rem)", "name": "Hero" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#F5F1EA",
      "text": "#151822"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "0",
        "right": "0"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "var(--wp--preset--font-size--md)",
      "fontWeight": "400",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--platypi)",
          "fontWeight": "500",
          "lineHeight": "1.02",
          "letterSpacing": "-0.045em"
        }
      },
      "link": {
        "color": { "text": "#151822" },
        "typography": { "textDecoration": "none" },
        ":hover": { "color": { "text": "#B85C45" } }
      },
      "button": {
        "color": { "background": "#B85C45", "text": "#FFFFFF" },
        "border": { "radius": "999px", "width": "0" },
        "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.5rem", "right": "1.5rem" } },
        "typography": { "fontSize": "0.78rem", "fontWeight": "700", "letterSpacing": "0.09em", "textTransform": "uppercase" }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontSize": "0.8rem", "fontWeight": "650", "letterSpacing": "0.06em", "textTransform": "uppercase" }
      }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Header" },
    { "area": "footer", "name": "footer", "title": "Footer" }
  ]
}

